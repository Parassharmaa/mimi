#!/bin/zsh
set -euo pipefail

MIMI_BENCHMARK_ROOT="${0:A:h}"
MIMI_BENCHMARK_COMMAND="${1:-}"
case "$MIMI_BENCHMARK_COMMAND" in
  prepare_suite|import_public_speech|run|baseline|report|compare|test_contract) ;;
  *)
    print -u2 "Usage: scripts/benchmarks/bench {prepare_suite|import_public_speech|run|baseline|report|compare|test_contract} [arguments...]"
    exit 2
    ;;
esac
shift

# Match the retained foundation baseline's Python and Unicode normalization.
exec uv run --no-project --python 3.12.12 \
  --with-requirements "$MIMI_BENCHMARK_ROOT/requirements.txt" \
  python "$MIMI_BENCHMARK_ROOT/$MIMI_BENCHMARK_COMMAND.py" "$@"
